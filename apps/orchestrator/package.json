{
  "name": "orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Receives Jira webhooks and runs the AI QA agent when a ticket enters In Testing",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ai-qa/agent": "*",
    "@ai-qa/llm": "*",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  }
}
