# =====================================================================
#  AI QA Agent configuration
#  Copy to .env (or run `npm run setup`), then fill in the AI model part.
#  .env is git-ignored: your API key never leaves your machine.
# =====================================================================

# ---- AI model (required) ---------------------------------------------
# Pick ONE provider:
#   gemini             free API key: https://aistudio.google.com/apikey
#   openai             https://platform.openai.com/api-keys
#   anthropic          https://console.anthropic.com/settings/keys
#   ollama             local models, no key needed (https://ollama.com)
#   openai-compatible  any OpenAI-style API (Groq, OpenRouter, LM Studio, vLLM...) + LLM_BASE_URL
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_BASE_URL=
# native = the provider's built-in tool calling (default)
# json   = prompt-based fallback for models without tool calling (some small local models)
LLM_TOOL_MODE=native
# Can the model read screenshots? Used by the look tool for criteria about appearance (colours, borders...).
# Leave empty for the default: true for gemini/openai/anthropic, false for ollama/openai-compatible.
LLM_VISION=
# Models to switch to (same provider, comma-separated) if the main one is overloaded (HTTP 503) or rate-limited (429).
LLM_FALLBACK_MODELS=gemini-3.6-flash
# HTTP retries per request before giving up / falling back (default 5 ≈ 1 minute of backoff)
LLM_MAX_RETRIES=5

# Examples:
#   Gemini     LLM_PROVIDER=gemini      LLM_MODEL=gemini-3.5-flash-lite
#   OpenAI     LLM_PROVIDER=openai      LLM_MODEL=<any chat model your key can use>
#   Anthropic  LLM_PROVIDER=anthropic   LLM_MODEL=claude-sonnet-5-5
#   Ollama     LLM_PROVIDER=ollama      LLM_MODEL=qwen3        (LLM_BASE_URL defaults to http://localhost:11434/v1)
#   Groq       LLM_PROVIDER=openai-compatible  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=<model id>
# Verify your settings with: npm run llm:check

# ---- Agent behaviour --------------------------------------------------
# Show the browser while the agent works (great for demos)
AGENT_HEADLESS=false
# Slow each browser action down so a human can follow (ms)
AGENT_SLOW_MO_MS=150
# Safety limits per run
AGENT_MAX_STEPS=60
AGENT_TIMEOUT_SECONDS=600
# Save a screenshot after every action (verdict screenshots are always saved)
AGENT_STEP_SCREENSHOTS=true
# Browser: Playwright's Chromium by default (npx playwright install chromium).
# Set AGENT_BROWSER_CHANNEL=chrome (or msedge) to use the browser already on your machine,
# or AGENT_BROWSER_PATH to point at a specific Chromium binary.
AGENT_BROWSER_CHANNEL=
AGENT_BROWSER_PATH=

# ---- Jira workflow ----------------------------------------------------
QA_TRIGGER_STATUS=In Testing
QA_STATUS_ON_PASS=Done
QA_STATUS_ON_FAIL=In Progress
# Bug tickets for failed acceptance criteria:
#   per-defect    one Bug per underlying defect (criteria failing for the same reason share one Bug)
#   per-criterion one Bug per failed acceptance criterion
#   off           no Bug tickets; failures are reported only on the original ticket
QA_BUG_TICKETS=per-defect

# ---- Services ---------------------------------------------------------
SAMPLE_APP_PORT=5173
MOCK_JIRA_PORT=4000
# The board resets to the seed tickets on every start; true keeps the last session's board
MOCK_JIRA_KEEP_DATA=false
ORCHESTRATOR_PORT=4100
# Where the mock Jira sends webhooks (like a Jira webhook URL)
JIRA_WEBHOOK_URL=http://localhost:4100/webhooks/jira
# Where the orchestrator talks to Jira. For a real Jira Cloud site set the URL
# plus JIRA_EMAIL and JIRA_API_TOKEN (comments would also need ADF; see README).
JIRA_BASE_URL=http://localhost:4000
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# Fallback app URL when a ticket has no "Test URL:" line
APP_UNDER_TEST_URL=http://localhost:5173
