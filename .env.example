# Where the mock Jira sends webhooks (like a Jira webhook URL)
JIRA_WEBHOOK_URL=http://localhost:4100/webhooks/jira
# Where the orchestrator talks to Jira (swap for https://your-domain.atlassian.net later)
JIRA_BASE_URL=http://localhost:4000

# The web app under test
APP_UNDER_TEST_URL=http://localhost:5173

